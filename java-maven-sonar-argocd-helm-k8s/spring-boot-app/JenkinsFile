pipeline {

  agent {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  stages {

    // =========================
    // 1. Checkout Source Code
    // =========================
    stage('Checkout') {
      steps {
        echo 'Checking out source code from GitHub'

        git branch: 'main',
            url: 'https://github.com/kakaralaDharani/Jenkins-Zero-To-Hero.git'
      }
    }


    // =========================
    // 2. Build and Test
    // =========================
    stage('Build and Test') {
      steps {

        sh 'ls -ltr'

        sh '''
          cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
          mvn clean package
        '''
      }
    }


    // =========================
    // 3. SonarQube Analysis
    // =========================
    stage('Static Code Analysis') {

  environment {
    SONAR_URL = "http://134.33.64.177:9000"
  }

  steps {

    withCredentials([
      string(
        credentialsId: 'sonar',
        variable: 'SONAR_TOKEN'
      )
    ]) {

      sh '''
        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
          -Dsonar.token=$SONAR_TOKEN \
          -Dsonar.host.url=${SONAR_URL}
      '''
    }
  }
}


    //===========
    //* . Docker version
    //==========
    stage('Upgrade Docker CLI') {
    steps {
        sh '''
            apt-get update
            apt-get install -y docker-ce-cli

            echo "Docker version after upgrade:"
            docker version
        '''
    }
}


     stage('Check Jenkins Docker') {
    steps {
        sh '''
            echo "PATH=$PATH"
            echo "USER=$(whoami)"
            echo "HOST=$(hostname)"
            echo "Docker binary:"
            which docker
            ls -l $(which docker)
            echo "Docker version:"
            docker version
            echo "Docker API environment:"
            env | grep DOCKER || true
        '''
    }
}
    // =========================
    // 4. Build and Push Docker
    // =========================
    stage('Build and Push Docker Image') {

    environment {
        DOCKER_IMAGE = "dharani14ra/ultimate-cicd:${BUILD_NUMBER}"
    }

    steps {
        script {

            sh '''
                echo "Checking Docker versions..."
                docker version

                cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                echo "Building Docker image: ${DOCKER_IMAGE}"
                docker build -t ${DOCKER_IMAGE} .
            '''

            def dockerImage = docker.image("${DOCKER_IMAGE}")

            docker.withRegistry(
                'https://index.docker.io/v1/',
                'docker-cred'
            ) {
                dockerImage.push()
            }
        }
    }
}
         

          


    // =========================
    // 5. Update Kubernetes YAML
    // =========================
    stage('Update Deployment File') {

      environment {

        GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
        GIT_USER_NAME = "kakaralaDharani"

      }

      steps {

        withCredentials([
          string(
            credentialsId: 'github',
            variable: 'GITHUB_TOKEN'
          )
        ]) {

          sh '''
            git config user.email "kakaraladharani14@gmail.com"
            git config user.name "kakaralaDharani"

            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
              java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git add \
              java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git commit \
              -m "Update deployment image to version ${BUILD_NUMBER}" || true

            git push \
              https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
              HEAD:main
          '''
        }
      }
    }

  }
}

